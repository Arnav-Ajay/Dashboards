    <worksheet name='Narrative'>
      <table>
        <view>
          <datasources>
            <datasource caption='Ontario Fruit Production' name='federated.1fozpaa18at8wz0zwjfvy04kw4fs' />
          </datasources>
          <datasource-dependencies datasource='federated.1fozpaa18at8wz0zwjfvy04kw4fs'>
            <column caption='Selected Year' datatype='string' name='[Calculation_1394427101623156740]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// SelectedYear (string)&#13;&#10;IF MIN([Year]) = MAX([Year]) THEN&#13;&#10;    STR(YEAR(MIN([Year])))&#13;&#10;ELSE&#13;&#10;    STR(YEAR(MIN([Year]))) + &quot;–&quot; + STR(YEAR(MAX([Year])))&#13;&#10;END' />
            </column>
            <column caption='Narrative_nonagg' datatype='string' name='[Calculation_1394427101821349898]' role='measure' type='nominal'>
              <calculation class='tableau' formula='&quot;Top county for &quot;&#13;&#10;+ [Calculation_1394427101623156740]&#13;&#10;+ &quot; is : &quot; &#13;&#10;+ [Calculation_1394427101821820939]&#13;&#10;+ &quot; — &quot;' />
            </column>
            <column caption='TopCountyName' datatype='string' name='[Calculation_1394427101821820939]' role='measure' type='nominal'>
              <calculation class='tableau' formula='ATTR( IF [Geography_Level (ontario_fruit_production_clean.csv)] = &quot;County&quot; THEN&#13;&#10;        // If only one fruit is selected, fix by Fruit&#13;&#10;        IF { INCLUDE  : COUNTD([Fruit]) } = 1 THEN&#13;&#10;            IF [Farm Value ($&apos;000)] =&#13;&#10;                { INCLUDE [Fruit] :&#13;&#10;                    MAX(&#13;&#10;                        IF [Geography_Level (ontario_fruit_production_clean.csv)] = &quot;County&quot; THEN [Farm Value ($&apos;000)] END&#13;&#10;                    )&#13;&#10;                }&#13;&#10;            THEN [Geography (ontario_fruit_production_clean.csv)]&#13;&#10;            END&#13;&#10;        ELSE&#13;&#10;            // If multiple fruits selected, fix overall&#13;&#10;            IF [Farm Value ($&apos;000)] =&#13;&#10;                { INCLUDE :&#13;&#10;                    MAX(&#13;&#10;                        IF [Geography_Level (ontario_fruit_production_clean.csv)] = &quot;County&quot; THEN [Farm Value ($&apos;000)] END&#13;&#10;                    )&#13;&#10;                }&#13;&#10;            THEN [Geography (ontario_fruit_production_clean.csv)]&#13;&#10;            END&#13;&#10;        END&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='TopFarmValue' datatype='integer' name='[Calculation_1394427102315163667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ INCLUDE [Year]:&#13;&#10;    SUM(&#13;&#10;        IF [Geography (ontario_fruit_production_clean.csv)] = &#13;&#10;           { INCLUDE [Year]: MAX(IF [Farm Value ($&apos;000)] = { INCLUDE [Year]: MAX([Farm Value ($&apos;000)]) } THEN [Geography (ontario_fruit_production_clean.csv)] END) }&#13;&#10;        THEN [Farm Value ($&apos;000)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column aggregation='Max' caption='Narative_agg' datatype='string' name='[Calculation_1394427102319018004]' role='measure' type='nominal'>
              <calculation class='tableau' formula='&quot; with Farm Value of $&quot;&#13;&#10;+ STR([Calculation_1394427102315163667])&#13;&#10;+ &quot;K and Total Market Production of &quot;&#13;&#10;+ STR([Calculation_1394427102319661077])&#13;&#10;+ &quot; Pounds (lbs)&quot;' />
            </column>
            <column caption='TopMarketProd' datatype='integer' name='[Calculation_1394427102319661077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ INCLUDE [Year]:&#13;&#10;    SUM(&#13;&#10;        IF [Geography (ontario_fruit_production_clean.csv)] = &#13;&#10;           { INCLUDE [Year]: MAX(IF [Marketed Production (&apos;000 lbs)] = { INCLUDE [Year]: MAX([Marketed Production (&apos;000 lbs)]) } THEN [Geography (ontario_fruit_production_clean.csv)] END) }&#13;&#10;        THEN [Marketed Production (&apos;000 lbs)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column datatype='integer' default-format='c&quot;$&quot;#,##0&quot; K&quot;;(&quot;$&quot;#,##0&quot; K&quot;)' name='[Farm Value ($&apos;000)]' role='measure' type='quantitative' />
            <column datatype='string' name='[Fruit]' role='dimension' type='nominal' />
            <column caption='Geography' datatype='string' name='[Geography (ontario_fruit_production_clean.csv)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Geography_Level (ontario_fruit_production_clean.csv)]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Marketed Production (&apos;000 lbs)]' role='measure' type='quantitative' />
            <column datatype='date' datatype-customized='true' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_1394427102319018004]' derivation='Max' name='[max:Calculation_1394427102319018004:nk]' pivot='key' type='nominal' />
            <column-instance column='[Fruit]' derivation='None' name='[none:Fruit:nk]' pivot='key' type='nominal' />
            <column-instance column='[Geography (ontario_fruit_production_clean.csv)]' derivation='None' name='[none:Geography (ontario_fruit_production_clean.csv):nk]' pivot='key' type='nominal' />
            <column-instance column='[Geography_Level (ontario_fruit_production_clean.csv)]' derivation='None' name='[none:Geography_Level (ontario_fruit_production_clean.csv):nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1394427101821349898]' derivation='User' name='[usr:Calculation_1394427101821349898:nk]' pivot='key' type='nominal' />
            <column-instance column='[Year]' derivation='Year' name='[yr:Year:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1fozpaa18at8wz0zwjfvy04kw4fs].[Action (Geography (ontario_fruit_production_clean.csv))]'>
